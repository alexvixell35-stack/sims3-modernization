<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-11-20, docs/215 G1/G2: kernel VirtualAlloc + map view events with stacks, image loads for module names. -->
<WindowsPerformanceRecorder Version="1.0">
  <Profiles>
    <SystemCollector Id="SC" Name="NT Kernel Logger">
      <BufferSize Value="1024"/>
      <Buffers Value="256"/>
    </SystemCollector>
    <SystemProvider Id="SP">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="Loader"/>
        <Keyword Value="VirtualAllocation"/>
        <Keyword Value="VAMap"/>
      </Keywords>
      <Stacks>
        <Stack Value="VirtualAllocation"/>
        <Stack Value="MapFile"/>
      </Stacks>
    </SystemProvider>
    <Profile Id="Untr.Verbose.File" Name="Untr" Description="VirtualAlloc and map views with stacks" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SC">
          <SystemProviderId Value="SP"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
